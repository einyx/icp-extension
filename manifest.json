{
  "manifest_version": 3,
  "name": "iCloud Passwords",
  "version": "0.1.1",
  "description": "Your iCloud Keychain in Firefox: fill your logins, generate one-time codes, and record new ones - through a native host on your own machine.",
  "permissions": ["nativeMessaging", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "icp-linux@local",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Apple Passwords",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
